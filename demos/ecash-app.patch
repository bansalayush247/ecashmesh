@@ -0,0 +1,428 @@
+//! EcashMesh: which joined federation can pay a Lightning invoice, and through
+//! which gateway.
+//!
+//! EcashMesh asks the app's own Fedimint clients three read-only questions
+//! (balance, gateway send fees for the invoice, the federation's fee for the
+//! outgoing contract), checks every joined federation against the invoice and
+//! ranks the ones that can pay. The app's existing `send` then pays through
+//! the recommended federation and gateway. Nothing here spends.
+
+use std::{str::FromStr, sync::Arc, time::Duration};
+
+use ecashmesh_cashu::discovery::DiscoveryService;
+use ecashmesh_fedimint::{
+    FederationConfig, FedimintService, WalletClient, WalletGateway, WalletState,
+};
+use ecashmesh_sdk::{EcashMesh, EvaluateRequest};
+use fedimint_core::{config::FederationId, Amount};
+use fedimint_lnv2_client::LightningClientModule;
+use fedimint_lnv2_common::config::LightningClientConfig;
+use futures_util::future::BoxFuture;
+use lightning_invoice::Bolt11Invoice;
+use serde::Serialize;
+use serde_json::{json, Value};
+
+use crate::multimint::Multimint;
+
+const GATEWAY_LIST_TIMEOUT: Duration = Duration::from_secs(5);
+
+/// The federation and gateway EcashMesh recommends for one invoice.
+#[derive(Clone, Debug, Serialize)]
+pub struct EcashMeshRecommendation {
+    pub federation_id: FederationId,
+    pub federation_name: String,
+    /// Pass to `send` with `is_lnv2: true`.
+    pub gateway_url: String,
+    pub amount_msats: u64,
+    pub gateway_fee_msats: u64,
+    pub federation_fee_msats: u64,
+    /// `send`'s `amount_with_fees`: amount plus both fees.
+    pub amount_with_fees_msats: u64,
+    /// Other federations that can pay, best first.
+    pub alternatives: Vec<EcashMeshOption>,
+    /// Federations that cannot pay this invoice, and why.
+    pub not_usable: Vec<EcashMeshOption>,
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct EcashMeshOption {
+    pub federation_name: String,
+    /// Total fee when the federation can pay.
+    pub fee_msats: Option<u64>,
+    pub reason: Option<String>,
+}
+
+/// The app's clients as EcashMesh's evidence source.
+struct AppClients(Multimint);
+
+impl AppClients {
+    async fn client(
+        &self,
+        federation_id: &str,
+    ) -> Result<(FederationId, fedimint_client::ClientHandleArc), String> {
+        let id = FederationId::from_str(federation_id).map_err(|error| error.to_string())?;
+        let client = self
+            .0
+            .get_client(&id)
+            .await
+            .map_err(|error| error.to_string())?;
+        Ok((id, client))
+    }
+}
+
+impl WalletClient for AppClients {
+    fn state<'a>(&'a self, federation_id: &'a str) -> BoxFuture<'a, Result<WalletState, String>> {
+        Box::pin(async move {
+            let (_, client) = self.client(federation_id).await?;
+            let lnv2 = client
+                .get_first_module::<LightningClientModule>()
+                .map_err(|_| "This federation has no LNv2 Lightning module".to_owned())?;
+            let network = client
+                .config()
+                .await
+                .get_module::<LightningClientConfig>(lnv2.id)
+                .map_err(|error| error.to_string())?
+                .network
+                .to_string();
+            let balance_msat = client
+                .get_balance_for_btc()
+                .await
+                .map_err(|error| error.to_string())?
+                .msats;
+            Ok(WalletState {
+                balance_msat,
+                network,
+            })
+        })
+    }
+
+    /// The app's own gateway list (LNv2 only), with the fee each gateway
+    /// charges for this invoice: its minimum when it is the payee's node.
+    fn gateways<'a>(
+        &'a self,
+        federation_id: &'a str,
+        invoice: &'a str,
+    ) -> BoxFuture<'a, Result<Vec<WalletGateway>, String>> {
+        Box::pin(async move {
+            let (id, _) = self.client(federation_id).await?;
+            let invoice = Bolt11Invoice::from_str(invoice).map_err(|error| error.to_string())?;
+            let amount_msat = invoice
+                .amount_milli_satoshis()
+                .ok_or("This invoice has no amount")?;
+            let payee = invoice.get_payee_pub_key().to_string();
+            let gateways = self
+                .0
+                .list_gateways(None, Some(id), GATEWAY_LIST_TIMEOUT)
+                .await
+                .map_err(|error| error.to_string())?;
+            let fee = |(base, ppm): (u64, u64)| {
+                base.saturating_add(amount_msat.saturating_mul(ppm) / 1_000_000)
+            };
+            Ok(gateways
+                .into_iter()
+                .filter(|gateway| gateway.is_lnv2)
+                .filter_map(|gateway| {
+                    let gateway_id = gateway.lightning_node.clone()?;
+                    let minimum = (
+                        gateway
+                            .min_base_routing_fee
+                            .unwrap_or(gateway.base_routing_fee),
+                        gateway
+                            .min_ppm_routing_fee
+                            .unwrap_or(gateway.ppm_routing_fee),
+                    );
+                    let charged = if gateway_id == payee {
+                        minimum
+                    } else {
+                        (gateway.base_routing_fee, gateway.ppm_routing_fee)
+                    };
+                    Some(WalletGateway {
+                        gateway_id,
+                        gateway_url: gateway.endpoint.clone(),
+                        fee_base_msat: charged.0,
+                        fee_ppm: charged.1,
+                        routing_fee_budget_msat: fee(charged).checked_sub(fee(minimum)),
+                        lightning_alias: gateway.lightning_alias.clone(),
+                    })
+                })
+                .collect())
+        })
+    }
+
+    fn send_fee_quote<'a>(
+        &'a self,
+        federation_id: &'a str,
+        contract_msat: u64,
+    ) -> BoxFuture<'a, Result<u64, String>> {
+        Box::pin(async move {
+            let (_, client) = self.client(federation_id).await?;
+            let lnv2 = client
+                .get_first_module::<LightningClientModule>()
+                .map_err(|_| "This federation has no LNv2 Lightning module".to_owned())?;
+            let quote = lnv2
+                .send_fee_quote(Amount::from_msats(contract_msat))
+                .await
+                .map_err(|error| error.to_string())?;
+            Ok(quote.total().get_bitcoin().msats)
+        })
+    }
+}
+
+/// Asks EcashMesh which joined federation should pay `bolt11`.
+pub(crate) async fn recommend(
+    multimint: &Multimint,
+    bolt11: &str,
+) -> anyhow::Result<EcashMeshRecommendation> {
+    let invoice = Bolt11Invoice::from_str(bolt11)?;
+    let amount_msats = invoice
+        .amount_milli_satoshis()
+        .ok_or_else(|| anyhow::anyhow!("This invoice has no amount, which is not supported"))?;
+    anyhow::ensure!(
+        amount_msats % 1_000 == 0,
+        "EcashMesh compares whole-sat amounts only"
+    );
+    let names = multimint
+        .federations()
+        .await
+        .into_iter()
+        .map(|(selector, _)| (selector.federation_id, selector.federation_name))
+        .collect::<Vec<_>>();
+    let source_id = |id: &FederationId| format!("fedimint:{id}");
+    let name = |source: &str| {
+        names
+            .iter()
+            .find(|(id, _)| source_id(id) == source)
+            .map_or_else(|| source.to_owned(), |(_, name)| name.clone())
+    };
+    let configs = names
+        .iter()
+        .map(|(id, name)| FederationConfig::wallet_client(&id.to_string(), name))
+        .collect();
+    let fedimint = FedimintService::new(configs, 60)
+        .map_err(anyhow::Error::msg)?
+        .with_wallet_client(Arc::new(AppClients(multimint.clone())))
+        // Regtest gateways listen on loopback HTTP.
+        .with_regtest_lab_loopback_gateways(invoice.network() == bitcoin::Network::Regtest);
+    let cashu = DiscoveryService::new(Vec::new(), Vec::new(), Vec::new(), 60)
+        .map_err(anyhow::Error::msg)?;
+    let mesh = EcashMesh::builder(cashu, fedimint).build();
+
+    let request: EvaluateRequest = serde_json::from_value(json!({
+        "amount": amount_msats / 1_000,
+        "asset": "BTC",
+        "destination": {"type": "lightning", "value": bolt11},
+        "payment_intent": "send",
+        "federation_connector_ids": names.iter().map(|(id, _)| source_id(id)).collect::<Vec<_>>(),
+        // Only the wallet's own federations may pay.
+        "strict_source_registry": true,
+    }))?;
+    let decision = match mesh.evaluate(request).await {
+        Ok(decision) => serde_json::to_value(decision)?,
+        Err(error) => anyhow::bail!(
+            "No joined federation can pay this invoice: {}",
+            std::iter::once(error.message)
+                .chain(error.details)
+                .collect::<Vec<_>>()
+                .join("; ")
+        ),
+    };
+
+    let quotes = decision["live"]["quote_observations"]
+        .as_array()
+        .cloned()
+        .unwrap_or_default();
+    let quote = |source: &str| {
+        quotes.iter().find(|quote| {
+            quote["kind"] == "fedimint_lightning_fee_quote" && quote["connector"] == source
+        })
+    };
+    let evidence = |source: &str| -> Option<Value> {
+        quote(source)
+            .filter(|quote| quote["state"] == "known")
+            .map(|quote| quote["value"]["native_evidence"].clone())
+    };
+    let msats = |value: &Value, field: &str| value[field].as_u64().unwrap_or_default();
+    let recommended = decision["recommended_source"]["source_id"]
+        .as_str()
+        .ok_or_else(|| anyhow::anyhow!("EcashMesh returned no recommendation"))?
+        .to_owned();
+    let chosen = evidence(&recommended)
+        .ok_or_else(|| anyhow::anyhow!("The recommended federation has no quote"))?;
+
+    let alternatives = decision["alternative_sources"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|route| route["source_id"].as_str())
+        .filter_map(|source| {
+            evidence(source).map(|quote| EcashMeshOption {
+                federation_name: name(source),
+                fee_msats: Some(msats(&quote, "total_fee_msat")),
+                reason: None,
+            })
+        })
+        .collect();
+    let not_usable = names
+        .iter()
+        .map(|(id, _)| source_id(id))
+        .filter(|source| source != &recommended && evidence(source).is_none())
+        .map(|source| EcashMeshOption {
+            federation_name: name(&source),
+            fee_msats: None,
+            reason: Some(
+                quote(&source)
+                    .and_then(|quote| quote["issue"]["message"].as_str())
+                    .unwrap_or("No quote")
+                    .to_owned(),
+            ),
+        })
+        .collect();
+
+    let gateway_fee_msats = msats(&chosen, "gateway_fee_msat");
+    let federation_fee_msats = msats(&chosen, "federation_fee_msat");
+    Ok(EcashMeshRecommendation {
+        federation_id: FederationId::from_str(
+            recommended
+                .strip_prefix("fedimint:")
+                .unwrap_or(&recommended),
+        )?,
+        federation_name: name(&recommended),
+        gateway_url: chosen["gateway_url"]
+            .as_str()
+            .ok_or_else(|| anyhow::anyhow!("The quote names no gateway"))?
+            .to_owned(),
+        amount_msats,
+        gateway_fee_msats,
+        federation_fee_msats,
+        amount_with_fees_msats: amount_msats + gateway_fee_msats + federation_fee_msats,
+        alternatives,
+        not_usable,
+    })
+}
+
+#[cfg(test)]
+mod lab {
+    //! The app's own wallet engine against the EcashMesh regtest lab:
+    //!
+    //! ```sh
+    //! ECASHMESH_LAB_INVITES=<invite>,<invite>,.. \
+    //! ECASHMESH_LAB_API=http://127.0.0.1:5000 \
+    //! ECASHMESH_LAB_PAYINVOICE="lncli ... payinvoice --force" \
+    //!   cargo test lab -- --ignored --nocapture
+    //! ```
+    //!
+    //! Joins every federation, funds only the first, then asks EcashMesh which
+    //! one should pay a lab invoice and pays it with the app's `send`.
+
+    use fedimint_lnv2_client::FinalReceiveOperationState;
+
+    use crate::multimint::LightningSendOutcome;
+
+    fn env(name: &str) -> String {
+        std::env::var(name).unwrap_or_else(|_| panic!("{name} is required"))
+    }
+
+    /// Pays `invoice` from the lab's payee node.
+    fn pay(invoice: &str) {
+        let command = env("ECASHMESH_LAB_PAYINVOICE");
+        let mut words = command.split_whitespace();
+        let status = std::process::Command::new(words.next().unwrap())
+            .args(words)
+            .arg(invoice)
+            .stdout(std::process::Stdio::null())
+            .status()
+            .unwrap();
+        assert!(status.success(), "paying the funding invoice failed");
+    }
+
+    async fn payee_invoice(amount_sats: u64) -> String {
+        let response: serde_json::Value = reqwest::Client::new()
+            .post(format!("{}/v1/lab/invoice", env("ECASHMESH_LAB_API")))
+            .json(&serde_json::json!({"amount_sats": amount_sats, "payee": "lnd-2"}))
+            .send()
+            .await
+            .unwrap()
+            .json()
+            .await
+            .unwrap();
+        response["invoice"].as_str().unwrap().to_owned()
+    }
+
+    #[tokio::test(flavor = "multi_thread")]
+    #[ignore = "needs the EcashMesh regtest lab"]
+    async fn pays_through_the_federation_ecashmesh_recommends() {
+        let dir = std::env::temp_dir().join(format!("ecashapp-ecashmesh-{}", std::process::id()));
+        crate::create_new_multimint(dir.to_string_lossy().into(), true).await;
+        let mut joined = Vec::new();
+        for invite in env("ECASHMESH_LAB_INVITES").split(',') {
+            joined.push(
+                crate::join_federation(invite.to_owned(), false)
+                    .await
+                    .unwrap(),
+            );
+        }
+        let funded = joined[0].federation_id;
+
+        // Fund only the first federation, through its LNv2 gateway.
+        let gateway = crate::list_gateways(None, Some(funded))
+            .await
+            .unwrap()
+            .into_iter()
+            .find(|gateway| gateway.is_lnv2)
+            .expect("an LNv2 gateway");
+        let amount = 20_000_000;
+        let fees = crate::compute_receive_amount_with_fees(
+            &funded,
+            gateway.endpoint.clone(),
+            true,
+            amount,
+            true,
+        )
+        .await
+        .unwrap();
+        let (invoice, operation, ..) = crate::receive(
+            &funded,
+            fees.invoice_msats,
+            amount,
+            fees.federation_fee_msats,
+            fees.gateway_fee_msats,
+            gateway.endpoint,
+            true,
+        )
+        .await
+        .unwrap();
+        pay(&invoice);
+        let (state, _) = crate::await_receive(&funded, operation).await.unwrap();
+        assert!(
+            matches!(state, FinalReceiveOperationState::Claimed),
+            "{state:?}"
+        );
+
+        let invoice = payee_invoice(5_000).await;
+        let recommendation = super::recommend(&crate::get_multimint(), &invoice)
+            .await
+            .unwrap();
+        println!("{recommendation:#?}");
+        assert_eq!(recommendation.federation_id, funded);
+        assert_eq!(recommendation.not_usable.len(), joined.len() - 1);
+
+        let operation = crate::send(
+            &recommendation.federation_id,
+            invoice,
+            recommendation.gateway_url,
+            true,
+            recommendation.amount_with_fees_msats,
+            recommendation.federation_fee_msats,
+            recommendation.gateway_fee_msats,
+            None,
+        )
+        .await
+        .unwrap();
+        let outcome = crate::await_send(&recommendation.federation_id, operation).await;
+        assert!(
+            matches!(outcome, LightningSendOutcome::Success(_)),
+            "{outcome:?}"
+        );
+        let _ = std::fs::remove_dir_all(dir);
+    }
+}
