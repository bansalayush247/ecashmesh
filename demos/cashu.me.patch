@@ -0,0 +1,214 @@
+<template>
+  <div class="ecashmesh-panel q-mt-md" data-testid="ecashmesh-panel">
+    <div class="row items-center no-wrap q-mb-sm">
+      <RouteIcon :size="18" class="q-mr-sm text-primary" />
+      <div class="col text-weight-bold">EcashMesh</div>
+      <q-spinner v-if="loading" size="16px" color="grey-6" />
+    </div>
+
+    <!-- One mint can pay: recommend it -->
+    <template v-if="recommendation">
+      <div class="detail-item q-mb-xs">
+        <div class="detail-name">Best mint</div>
+        <div class="detail-value" data-testid="ecashmesh-recommended-mint">
+          {{ mintLabel(recommendation.mintUrl) }}
+        </div>
+      </div>
+      <div class="detail-item q-mb-xs">
+        <div class="detail-name">Fee estimate</div>
+        <div class="detail-value">
+          {{
+            recommendation.feeSats == null
+              ? "unknown"
+              : `up to ${formatSats(recommendation.feeSats)}`
+          }}
+        </div>
+      </div>
+      <div v-if="recommendation.reason" class="text-caption text-grey-6">
+        {{ recommendation.reason }}
+      </div>
+      <q-btn
+        v-if="!sameMint(recommendation.mintUrl, activeMintUrl)"
+        class="full-width q-mt-sm"
+        flat
+        rounded
+        color="primary"
+        data-testid="ecashmesh-use-mint"
+        :label="`Pay from ${mintLabel(recommendation.mintUrl)}`"
+        @click="selectMintUrl(recommendation.mintUrl, 'sat')"
+      />
+    </template>
+
+    <!-- Several mints pay parts of the invoice -->
+    <template v-else-if="splitPlan">
+      <div
+        v-for="part in splitPlan.parts"
+        :key="part.melt_quote_id"
+        class="detail-item q-mb-xs"
+        data-testid="ecashmesh-split-part"
+      >
+        <div class="detail-name row items-center no-wrap">
+          <q-icon
+            :name="partIcon(partStates[part.melt_quote_id])"
+            :color="partColor(partStates[part.melt_quote_id])"
+            size="16px"
+            class="q-mr-xs"
+          />
+          {{ mintLabel(part.mint_url) }}
+        </div>
+        <div class="detail-value">
+          {{ formatSats(part.amount_sats) }}
+          <span class="text-caption text-grey-6">
+            + ≤ {{ formatSats(part.fee_reserve_sats) }} fee
+          </span>
+        </div>
+      </div>
+      <div class="text-caption text-grey-6">
+        Every part settles, or none does.
+      </div>
+      <q-btn
+        v-if="!splitPaid"
+        class="full-width q-mt-sm"
+        unelevated
+        rounded
+        color="primary"
+        data-testid="ecashmesh-pay-split"
+        :loading="splitPaying"
+        :label="`Pay from ${splitPlan.parts.length} mints`"
+        @click="$emit('pay-split')"
+      />
+    </template>
+
+    <!-- No single mint holds enough, together they do -->
+    <template v-else-if="canSplit">
+      <div class="text-caption text-grey-6">
+        No single mint holds enough for this invoice, but your mints do
+        together.
+      </div>
+      <q-btn
+        class="full-width q-mt-sm"
+        flat
+        rounded
+        color="primary"
+        data-testid="ecashmesh-plan-split"
+        label="Split across mints"
+        @click="planSplit"
+      />
+    </template>
+
+    <div
+      v-else-if="!loading && !error"
+      class="text-caption text-grey-6"
+      data-testid="ecashmesh-no-route"
+    >
+      No mint in this wallet can pay this invoice.
+    </div>
+
+    <div v-if="error" class="text-caption text-negative q-mt-xs">
+      {{ error }}
+    </div>
+  </div>
+</template>
+
+<script lang="ts">
+import { defineComponent } from "vue";
+import { mapActions, mapState } from "pinia";
+import { Route as RouteIcon } from "lucide-vue-next";
+import {
+  sameMint,
+  useEcashMeshStore,
+  type SplitPartState,
+} from "src/stores/ecashmesh";
+import { useMintsStore } from "src/stores/mints";
+import { useUiStore } from "src/stores/ui";
+import { getShortUrl } from "src/js/wallet-helpers";
+
+export default defineComponent({
+  name: "EcashMeshPanel",
+  components: { RouteIcon },
+  props: {
+    request: { type: String, required: true },
+    amount: { type: Number, required: true },
+  },
+  emits: ["pay-split"],
+  computed: {
+    ...mapState(useEcashMeshStore, [
+      "loading",
+      "error",
+      "recommendation",
+      "splitPlan",
+      "partStates",
+      "splitPaying",
+      "splitPaid",
+      "canSplit",
+    ]),
+    ...mapState(useMintsStore, ["mints", "activeMintUrl"]),
+  },
+  watch: {
+    request: {
+      handler() {
+        // One evaluation per invoice. The wallet clears the invoice after
+        // paying, so an empty request keeps the result on screen.
+        if (!this.request || this.amount <= 0) return;
+        if (this.request === useEcashMeshStore().request) return;
+        this.recommend(this.request, this.amount);
+      },
+      immediate: true,
+    },
+  },
+  methods: {
+    sameMint,
+    ...mapActions(useEcashMeshStore, ["recommend", "planSplit"]),
+    ...mapActions(useMintsStore, ["selectMintUrl"]),
+    mintLabel(url: string): string {
+      const mint = this.mints.find((m) => sameMint(m.url, url));
+      return mint?.nickname || mint?.info?.name || getShortUrl(url);
+    },
+    formatSats(sats: number): string {
+      return useUiStore().formatCurrency(sats, "sat");
+    },
+    partIcon(state?: SplitPartState): string {
+      return state === "paid"
+        ? "check_circle"
+        : state === "failed"
+        ? "error"
+        : state === "paying"
+        ? "sync"
+        : "radio_button_unchecked";
+    },
+    partColor(state?: SplitPartState): string {
+      return state === "paid"
+        ? "positive"
+        : state === "failed"
+        ? "negative"
+        : "primary";
+    },
+  },
+});
+</script>
+
+<style scoped>
+.ecashmesh-panel {
+  border: 1px solid rgba(128, 128, 128, 0.25);
+  border-radius: 14px;
+  padding: 12px 14px;
+}
+
+.detail-item {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+}
+
+.detail-name {
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--q-color-grey-6);
+}
+
+.detail-value {
+  font-size: 15px;
+  font-weight: 600;
+  text-align: right;
+}
+</style>
