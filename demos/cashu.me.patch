diff --git a/src/stores/ecashmesh.ts b/src/stores/ecashmesh.ts
new file mode 100644
index 0000000..db20e6b
--- /dev/null
+++ b/src/stores/ecashmesh.ts
@@ -0,0 +1,251 @@
+import { defineStore } from "pinia";
+import { MeltQuoteState } from "@cashu/cashu-ts";
+import type {
+  EcashMeshClient,
+  PaymentSource,
+  SplitPlan,
+} from "@ecashmesh/client/http";
+import { MintClass, useMintsStore } from "./mints";
+import { useProofsStore } from "./proofs";
+import { useUiStore } from "./ui";
+import { useWalletStore } from "./wallet";
+import { normalizeMeltQuote } from "./walletMelt";
+
+// EcashMesh advises which of the wallet's mints should pay a Lightning
+// invoice, and plans NUT-15 split payments when no single mint holds enough.
+// It never sees proofs: the wallet pays through its own melt path. Enabled
+// only when VITE_ECASHMESH_API_URL is set at build time.
+const apiUrl: string =
+  (import.meta as ImportMeta & { env: Record<string, string | undefined> }).env
+    .VITE_ECASHMESH_API_URL ?? "";
+// EcashMesh plans Lightning payments in sats.
+const UNIT = "sat";
+
+let client: Promise<EcashMeshClient> | undefined;
+function ecashMesh(): Promise<EcashMeshClient> {
+  // Loaded on first use, so the SDK stays out of wallets that do not enable it.
+  client ??= import("@ecashmesh/client/http").then(
+    ({ createEcashMeshClient }) => createEcashMeshClient({ baseUrl: apiUrl })
+  );
+  return client;
+}
+
+export const sameMint = (a: string, b: string) =>
+  a.replace(/\/+$/, "") === b.replace(/\/+$/, "");
+
+/** The wallet mint a ranked Cashu source refers to, if it is one of ours. */
+function walletMintFor(source: PaymentSource, mintUrls: string[]) {
+  const url = source.cashu_metrics?.mint_url;
+  return typeof url === "string"
+    ? mintUrls.find((mintUrl) => sameMint(mintUrl, url))
+    : undefined;
+}
+
+export type MintRecommendation = {
+  mintUrl: string;
+  /** Upper bound the mint reserves for Lightning fees; unused is returned. */
+  feeSats: number | null;
+  reason: string;
+};
+
+export type SplitPartState = "pending" | "paying" | "paid" | "failed";
+
+export const useEcashMeshStore = defineStore("ecashmesh", {
+  state: () => ({
+    enabled: apiUrl !== "",
+    request: "",
+    amount: 0,
+    loading: false,
+    error: "",
+    recommendation: null as MintRecommendation | null,
+    splitPlan: null as SplitPlan | null,
+    partStates: {} as Record<string, SplitPartState>,
+    splitPaying: false,
+    splitPaid: false,
+  }),
+  getters: {
+    /** Spendable sats per wallet mint: what EcashMesh plans with. */
+    balances(): Record<string, number> {
+      return Object.fromEntries(
+        useMintsStore()
+          .mints.map((mint) => new MintClass(mint))
+          .filter((mint) => mint.units.includes(UNIT))
+          .map((mint) => [mint.mint.url, mint.unitBalance(UNIT)])
+      );
+    },
+    /** No single mint can pay, but the wallet's mints together hold enough. */
+    canSplit(): boolean {
+      const total = Object.values(this.balances).reduce((a, b) => a + b, 0);
+      return (
+        this.amount > 0 &&
+        !this.loading &&
+        this.recommendation == null &&
+        total >= this.amount
+      );
+    },
+  },
+  actions: {
+    reset(request = "", amount = 0) {
+      this.request = request;
+      this.amount = amount;
+      this.loading = false;
+      this.error = "";
+      this.recommendation = null;
+      this.splitPlan = null;
+      this.partStates = {};
+      this.splitPaying = false;
+      this.splitPaid = false;
+    },
+    /** Asks EcashMesh which of the wallet's mints should pay `request`. */
+    async recommend(request: string, amount: number) {
+      this.reset(request, amount);
+      const balances = Object.fromEntries(
+        Object.entries(this.balances).filter(([, sats]) => sats > 0)
+      );
+      if (!Object.keys(balances).length) return;
+      this.loading = true;
+      try {
+        const decision = await (
+          await ecashMesh()
+        ).evaluateRoute({
+          amount,
+          asset: "BTC",
+          destination: { type: "lightning", value: request },
+          paymentIntent: "send",
+          // Only the wallet's mints are ranked; EcashMesh excludes any whose
+          // balance cannot cover the amount plus its fee reserve.
+          strictSourceRegistry: true,
+          walletMintBalances: balances,
+        });
+        if (this.request !== request) return;
+        const source = decision.recommended_source;
+        const mintUrl = source && walletMintFor(source, Object.keys(balances));
+        if (source && mintUrl) {
+          this.recommendation = {
+            mintUrl,
+            feeSats: source.fee.fee_reserve_sats ?? source.fee.amount ?? null,
+            reason: decision.explanation.reasons[0]?.message ?? "",
+          };
+        }
+      } catch (error) {
+        // No single mint can fund it: the panel offers a split instead.
+        const noRoute =
+          (error as { code?: string } | null)?.code === "NO_VIABLE_ROUTE";
+        if (this.request === request && !noRoute)
+          this.error = errorMessage(error);
+      } finally {
+        if (this.request === request) this.loading = false;
+      }
+    },
+    /** One NUT-15 part per mint; Lightning settles every part or none. */
+    async planSplit() {
+      const request = this.request;
+      this.loading = true;
+      this.error = "";
+      try {
+        const plan = await (
+          await ecashMesh()
+        ).planSplit({
+          amount: this.amount,
+          destination: { type: "lightning", value: request },
+          balances: Object.fromEntries(
+            Object.entries(this.balances).filter(([, sats]) => sats > 0)
+          ),
+        });
+        if (this.request !== request) return;
+        // Pay only a plan for exactly this invoice and amount.
+        const planned = plan.parts.reduce((sum, p) => sum + p.amount_sats, 0);
+        if (!sameInvoice(plan.invoice, request) || planned !== this.amount) {
+          throw new Error("EcashMesh returned a plan for another payment");
+        }
+        this.splitPlan = plan;
+        this.partStates = Object.fromEntries(
+          plan.parts.map((part) => [part.melt_quote_id, "pending"])
+        );
+      } catch (error) {
+        if (this.request === request) this.error = errorMessage(error);
+      } finally {
+        if (this.request === request) this.loading = false;
+      }
+    },
+    /** Melts every part concurrently, each with its own mint's proofs. */
+    async paySplit() {
+      const plan = this.splitPlan;
+      if (!plan || this.splitPaying || this.splitPaid) return;
+      const uiStore = useUiStore();
+      this.splitPaying = true;
+      this.error = "";
+      uiStore.beginForegroundPayment();
+      try {
+        const results = await Promise.allSettled(
+          plan.parts.map((part) => this.payPart(part, this.request))
+        );
+        const failures = results.flatMap((result) =>
+          result.status === "rejected" ? [errorMessage(result.reason)] : []
+        );
+        if (failures.length) {
+          this.error = `Split payment failed: ${failures.join("; ")}`;
+          return;
+        }
+        this.splitPaid = true;
+        useWalletStore().payInvoiceData.fee_paid = results.reduce(
+          (sum, result) =>
+            sum + (result.status === "fulfilled" ? result.value : 0),
+          0
+        );
+        uiStore.vibrate();
+      } finally {
+        this.splitPaying = false;
+        uiStore.endForegroundPayment();
+      }
+    },
+    /** Pays one part by its planned melt quote; returns the fee paid. */
+    async payPart(part: SplitPlan["parts"][number], invoice: string) {
+      const walletStore = useWalletStore();
+      const id = part.melt_quote_id;
+      try {
+        const mint = useMintsStore().mints.find((m) =>
+          sameMint(m.url, part.mint_url)
+        );
+        if (!mint) throw new Error(`${part.mint_url} is not in this wallet`);
+        const mintWallet = await walletStore.mintWallet(mint.url, UNIT, true);
+        // The plan only advises: check the quote at the mint before paying.
+        const quote = normalizeMeltQuote(
+          await mintWallet.mint.checkMeltQuoteBolt11(id)
+        );
+        if (
+          !sameInvoice(quote.request ?? "", invoice) ||
+          quote.amount !== part.amount_sats ||
+          quote.unit !== UNIT ||
+          quote.state !== MeltQuoteState.UNPAID
+        ) {
+          throw new Error(`Melt quote ${id} does not match the plan`);
+        }
+        this.partStates[id] = "paying";
+        const result = await walletStore.melt(
+          new MintClass(mint).unitProofs(UNIT),
+          quote,
+          mintWallet,
+          true, // silent: one notification for the whole payment
+          true, // release the mutex so the parts melt concurrently
+          "foreground"
+        );
+        this.partStates[id] = "paid";
+        return (
+          quote.fee_reserve - useProofsStore().sumProofs(result?.change ?? [])
+        );
+      } catch (error) {
+        this.partStates[id] = "failed";
+        throw error;
+      }
+    },
+  },
+});
+
+function sameInvoice(a: string, b: string) {
+  return a.toLowerCase() === b.toLowerCase();
+}
+
+function errorMessage(error: unknown) {
+  return error instanceof Error ? error.message : String(error);
+}
