# Browser / iOS simulator. Android emulator uses http://10.0.2.2:5000 by default.
# For a physical phone, use your computer's LAN IP and bind the API to 0.0.0.0:5000.
EXPO_PUBLIC_ECASHMESH_API_URL=http://127.0.0.1:5000
# Optional JSON array or comma-separated relay set. The app otherwise uses a
# small multi-relay public bootstrap set and then prefers the user's NIP-60/NIP-65 metadata.
EXPO_PUBLIC_NOSTR_RELAYS=["wss://relay.damus.io","wss://relay.primal.net"]
