{
  "name": "@ecashmesh/fedi-mini-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "prettier --write index.html src package.json tsconfig.json vite.config.ts README.md",
    "format:check": "prettier --check index.html src package.json tsconfig.json vite.config.ts README.md"
  },
  "dependencies": {
    "@cashu/cashu-ts": "^4.9.0",
    "@ecashmesh/client": "file:../../packages/client",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vite": "^7.3.7"
  }
}
