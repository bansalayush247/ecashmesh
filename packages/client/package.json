{
  "name": "@ecashmesh/client",
  "version": "0.1.0",
  "description": "TypeScript client for the EcashMesh API (@ecashmesh/client/http), plus the wallet's Nostr source registry (@ecashmesh/client/nostr)",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./http": "./src/http.ts",
    "./nostr": "./src/nostr/index.ts"
  },
  "typesVersions": {
    "*": {
      "http": [
        "src/http.ts"
      ],
      "nostr": [
        "src/nostr/index.ts"
      ]
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "nostr-tools": "^2.25.2",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "nostr-tools": {
      "optional": true
    }
  }
}
